{
    "_version": "1.72.0",
    "sap.app": {
        "id": "ui5.antares.pro",
        "type": "library",
        "title": "UI5 Antares Pro",
        "embeds": [
            "v2/component/create",
            "v2/component/update",
            "v2/component/delete",
            "v2/component/display"
        ],
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "phone": true,
            "tablet": true,
            "desktop": true
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.135.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "library": {
            "css": false,
            "i18n": {
                "bundleUrl": "i18n/i18n.properties",
                "supportedLocales": [
                    ""
                ],
                "fallbackLocale": ""
            }
        }
    }
}