{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "skipLibCheck": true,
        "allowJs": false,
        "strict": true,
        "strictPropertyInitialization": false,
        "rootDir": "./webapp",
        "outDir": "./dist",
        "sourceMap": false,
        "inlineSourceMap": false,
        "baseUrl": "./",
        "paths": {
            "test/v2/ui5/antares/pro/*": [
                "./webapp/*"
            ]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/@sapui5/types"
        ]
    },
    "include": [
        "webapp"
    ]
}