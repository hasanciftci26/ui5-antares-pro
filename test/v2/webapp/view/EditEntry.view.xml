<mvc:View
    controllerName="test.v2.ui5.antares.pro.controller.EditEntry"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="EditEntry"
        showHeader="true"
        title="UI5 Antares Pro Test Application"
    >
        <content>
            <core:ComponentContainer
                id="ccUI5AntaresProUpdateEntry"
                usage="ui5AntaresProUpdateEntry"
                componentCreated="onUpdateEntryComponentCreated"
            />
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Update"
                    type="Emphasized"
                    press="onUpdateEmployee"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
