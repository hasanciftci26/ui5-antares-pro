<mvc:View
    controllerName="test.v2.ui5.antares.pro.controller.Homepage"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="Homepage"
        showHeader="true"
        title="UI5 Antares Pro Test Application"
    >
        <content>
            <Text text="Test app" />
            <Button
                text="Test"
                press="onInitClass"
            />
            <core:ComponentContainer
                usage="ui5AntaresProEntry"
                componentCreated="onAntaresComponentCreated"
                propagateModel="true"               
                settings="{ 
                    entitySet: 'Products',
                    invisibleProperties: ['a', 'b', 'c']
                }"
            />
        </content>
    </Page>
</mvc:View>
