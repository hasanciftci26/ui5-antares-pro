    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="NewEntry"
        showHeader="true"
        title="UI5 Antares Pro Test Application"
    >
        <content>
            <core:ComponentContainer
                id="ccUI5AntaresProCreateEntry"
                usage="ui5AntaresProCreateEntry"
